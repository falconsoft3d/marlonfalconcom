  "scripts": {
    "dev": "node ./scripts/gen-posts-index.js && next",
    "build": "node ./scripts/gen-rss.js && node ./scripts/gen-posts-index.js && next build",
    "start": "next start",
    "cv:pdf": "node ./scripts/gen-cv-pdf.js",
    "webs:shots": "node ./scripts/gen-webs-shots.js",
    "owl:manual": "node ./scripts/gen-owl-manual.js",
    "owl:zip": "rm -f public/cursos/curso-owl-odoo-20-modulos.zip && cd data/curso-owl && zip -qr ../../public/cursos/curso-owl-odoo-20-modulos.zip curso_owl_ejemplos curso_owl_todo -x '*/.*'",
    "extension:zip": "rm -f public/torre-de-control-chrome.zip && cd extension && zip -qr ../public/torre-de-control-chrome.zip . -x '.*'",
    "postbuild": "next-sitemap"
  },
  "dependencies": {
    "@vercel/analytics": "^1.0.2",
    "gray-matter": "^4.0.2",
    "ical.js": "1.5.0",
    "next": "12.0.8",
    "nextra": "^2.0.0-beta.5",
    "nextra-theme-blog": "^2.0.0-beta.5",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "rss": "^1.2.2"
  },
  "prettier": {
    "arrowParens": "always",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none",
    "semi": false
  },
  "engines": {
    "node": ">=22 <23"
  },
  "volta": {
    "node": "22"
  },
  "devDependencies": {
    "next-sitemap": "^3.1.42"
  }
