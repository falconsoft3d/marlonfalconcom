{
  "manifest_version": 3,
  "name": "Torre de control de agentes",
  "version": "1.0.0",
  "description": "Sigue desde el panel lateral de Chrome qué hace cada agente de Claude, con su progreso y sus tareas.",
  "icons": { "16": "iconos/16.png", "48": "iconos/48.png", "128": "iconos/128.png" },
  "action": { "default_title": "Torre de control", "default_icon": { "16": "iconos/16.png", "48": "iconos/48.png" } },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["alarms", "notifications", "sidePanel", "storage"],
  "host_permissions": ["https://www.marlonfalcon.com/*", "http://localhost/*"]
}
