<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="curso_owl_ejemplos.CicloVida">
        <div class="p-3" t-ref="this.raiz">
            <p t-out="this.dato"/>
            <button class="btn btn-primary" t-on-click="() => this.clics.set(this.clics() + 1)">
                Clics: <t t-out="this.clics()"/>
            </button>
        </div>
    </t>

</templates>
